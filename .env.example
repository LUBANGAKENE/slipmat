# Copy to .env and fill in. .env is gitignored - never commit real keys.

# Vision model, via https://openrouter.ai
OPENROUTER_API_KEY=sk-or-v1-your-key-here
VINYL_MODEL=google/gemini-2.5-flash

# MusicBrainz asks for contact details in the User-Agent.
# MB_USER_AGENT=Slipmat/0.1 (you@example.com)

# BPM/key lookup goes through ReccoBeats, which needs no key. The Spotify
# hop is only used to turn "artist + title" into a track ID - it is optional
# but roughly doubles the hit rate. Free app at developer.spotify.com.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# Library (optional): sign in and save scanned albums. Free project at
# https://supabase.com, then run supabase/schema.sql in its SQL editor and
# copy these two from Project Settings -> API. The anon key is meant to be
# public - it goes to the browser, not just this process. Leave both blank
# to run without accounts, exactly as before.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
